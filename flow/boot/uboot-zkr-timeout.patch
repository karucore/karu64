+/**
+ * zkr_word() - poll the seed CSR for one word of entropy
+ *
+ * @val:	the value read, with status ES16, on success
+ * Return:	0 on success, -ENOENT if the source is dead, -ETIMEDOUT if it
+ *		stayed in BIST or WAIT for ZKR_TIMEOUT_MS
+ */
+static int zkr_word(u32 *val)
+{
+	ulong start = get_timer(0);
+
+	for (;;) {
+		*val = read_seed();
+
+		switch (*val >> 30) {
+		case ES16:
+			return 0;
+		case DEAD:
+			return -ENOENT;
+		}
+		if (get_timer(start) > ZKR_TIMEOUT_MS)
+			return -ETIMEDOUT;
+	}
+}
