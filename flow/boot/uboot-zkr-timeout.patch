+/*
+ * How long to wait for a word. The seed CSR may stay in BIST or WAIT for
+ * good: an entropy source that is held off, or one that is kept in its test
+ * mode, never leaves BIST. A caller must then get an error, not a hang.
+ */
+#define ZKR_TIMEOUT_MS 100
+
 enum opst {
 	/** @BIST: built in self test running */
 	BIST = 0b00,
@@ -33,29 +42,47 @@ static unsigned long read_seed(void)
