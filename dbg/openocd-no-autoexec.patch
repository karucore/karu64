+/* abstractauto is optional. Probe before executing a memory operation, so a
+ * missing autoexecdata0 cannot silently corrupt the block pipeline. Reuse the
+ * single-element path when absent; in particular, do not issue speculative or
+ * trailing loads to a side-effecting device. */
+static struct mem_access_result
+access_memory_progbuf_autoexec(struct target *target,
+		const struct riscv_mem_access_args args)
+{
+	const bool is_read = riscv_mem_access_is_read(args);
+	uint32_t autoexec = 1;
+	if (args.count > 1) {
+		if (dm_write(target, DM_ABSTRACTAUTO, 1) != ERROR_OK)
+			return mem_access_result(MEM_ACCESS_FAILED_DM_ACCESS_FAILED);
+		int result = dm_read(target, &autoexec, DM_ABSTRACTAUTO);
+		/* Always disable the probe before touching data registers. */
+		if (dm_write(target, DM_ABSTRACTAUTO, 0) != ERROR_OK || result != ERROR_OK)
+			return mem_access_result(MEM_ACCESS_FAILED_DM_ACCESS_FAILED);
+	}
+	if (args.count <= 1 || (autoexec & 1))
+		return is_read ? read_memory_progbuf(target, args) :
+				write_memory_progbuf(target, args);
+
+	for (uint32_t i = 0; i < args.count; ++i) {
+		struct riscv_mem_access_args item = args;
+		item.count = 1;
+		item.address += (target_addr_t)i * args.increment;
+		if (is_read)
+			item.read_buffer += (size_t)i * args.size;
+		else
+			item.write_buffer += (size_t)i * args.size;
+		struct mem_access_result result = is_read ?
+				read_memory_progbuf(target, item) : write_memory_progbuf(target, item);
+		if (!is_mem_access_ok(result))
+			return result;
+	}
+	return mem_access_result(MEM_ACCESS_OK);
+}
