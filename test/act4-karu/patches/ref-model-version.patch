+# SPDX-License-Identifier: Apache-2.0
+
+"""Exact per-configuration Sail version validation."""
+
+import os
+import subprocess
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from pydantic import ValidationError
+
+from act.config import Config, REQUIRED_SAIL_VERSION, check_ref_model_version
+
+
+class RefModelVersionTests(unittest.TestCase):
+    def config(self, **overrides: object) -> Config:
+        data: dict[str, object] = {
+            "name": "version-check",
+            "udb_config": str(Path(__file__).absolute()),
+            "linker_script": str(Path(__file__).absolute()),
+            "dut_include_dir": str(Path(__file__).parent.absolute()),
+            "compiler_exe": "riscv64-unknown-elf-gcc",
+            "ref_model_exe": "sail_riscv_sim",
+        }
+        data.update(overrides)
+        return Config.model_validate(data, context={"validate_tools": False})
+
+    def check_version(self, config: Config, reported: str) -> None:
+        with patch("act.config.subprocess.run") as run:
+            run.return_value = subprocess.CompletedProcess([], 0, stdout=f"{reported}\n", stderr="")
+            check_ref_model_version(config)
+            run.assert_called_once_with(
+                [str(config.ref_model_exe), "--version"],
+                capture_output=True,
+                text=True,
+                check=True,
+                timeout=5,
+            )
+
+    def test_omitted_version_requires_pinned_default(self) -> None:
+        config = self.config()
+        self.assertEqual(REQUIRED_SAIL_VERSION, "0.13.1")
+        self.assertIsNone(config.ref_model_version)
+        self.check_version(config, "0.13.1")
+        with self.assertRaisesRegex(ValueError, r"requires version 0\.13\.1, but 0\.14 was found"):
+            self.check_version(config, "0.14")
+
+    def test_null_version_retains_pinned_default(self) -> None:
+        config = self.config(ref_model_version=None)
+        self.check_version(config, "0.13.1")
+        with self.assertRaises(ValueError):
+            self.check_version(config, "0.14")
+
+    def test_explicit_version_is_exact(self) -> None:
+        config = self.config(ref_model_version="0.14")
+        self.check_version(config, "0.14")
+        for reported in ("0.13.1", "0.14.0", "0.14-dev", ""):
+            with self.subTest(reported=reported), self.assertRaises(ValueError):
+                self.check_version(config, reported)
+
+    def test_explicit_default_is_supported(self) -> None:
+        self.check_version(self.config(ref_model_version="0.13.1"), "0.13.1")
+
+    def test_invalid_version_strings_are_rejected(self) -> None:
+        for value in ("", " ", " 0.14", "0.14\n", 0.14):
+            with self.subTest(value=value), self.assertRaises(ValidationError):
+                self.config(ref_model_version=value)
+
+    def test_spike_version_override_is_rejected(self) -> None:
+        self.config(ref_model_exe="spike")
+        with self.assertRaisesRegex(ValidationError, "supported only for the Sail"):
+            self.config(ref_model_exe="spike", ref_model_version="0.14")
+
+    def test_nonzero_version_exit_is_rejected(self) -> None:
+        with patch("act.config.subprocess.run", side_effect=subprocess.CalledProcessError(1, "sail")):
+            with self.assertRaisesRegex(RuntimeError, "Failed to check Sail version"):
+                check_ref_model_version(self.config())
+
+    def test_version_timeout_is_rejected(self) -> None:
+        with patch("act.config.subprocess.run", side_effect=subprocess.TimeoutExpired("sail", 5)):
+            with self.assertRaisesRegex(RuntimeError, "Timeout while checking Sail version"):
+                check_ref_model_version(self.config())
+
+    @unittest.skipUnless(
+        os.environ.get("ACT_TEST_SAIL_DEFAULT") and os.environ.get("ACT_TEST_SAIL_OVERRIDE"),
+        "Set ACT_TEST_SAIL_DEFAULT and ACT_TEST_SAIL_OVERRIDE for real-executable checks.",
+    )
+    def test_real_sail_versions(self) -> None:
+        default_exe = os.environ["ACT_TEST_SAIL_DEFAULT"]
+        override_exe = os.environ["ACT_TEST_SAIL_OVERRIDE"]
+        version = os.environ.get("ACT_TEST_SAIL_VERSION", "0.14")
+        check_ref_model_version(self.config(ref_model_exe=default_exe))
+        check_ref_model_version(self.config(ref_model_exe=override_exe, ref_model_version=version))
+        with self.assertRaises(ValueError):
+            check_ref_model_version(self.config(ref_model_exe=override_exe))
+        with self.assertRaises(ValueError):
+            check_ref_model_version(self.config(ref_model_exe=default_exe, ref_model_version=version))
+
+
+if __name__ == "__main__":
+    unittest.main()
