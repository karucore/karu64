Negative control for dbg-auth-sba-revoke-test (dbg/auth.mk): the drained
read data is returned over DMI. Four layers stop that in the RTL and this
mutant removes all of them: the SBA engine stores a response that arrives
after the fall, keeps it (no clear while inactive), serves sbdata while
inactive, and the DM's locked view passes sbdata0/1 through. The launch
gate is intact. The DM's locked-read assertion is disabled; the bench's
DMI checks must report [LEAK] and its bus monitor no [LAUNCH].

--- a/dbg/karudbg.v
+++ b/dbg/karudbg.v
@@ -298,6 +298,7 @@
             case (req_addr_i)
                 7'h10: dmi_read = {31'b0, dmactive_q};
                 7'h11: dmi_read = {25'b0, auth_busy, 6'h03};
+                7'h3c, 7'h3d: dmi_read = sba_read;
                 7'h30: dmi_read = auth_impl ? auth_rdata : 32'b0;
                 default: ;
             endcase
@@ -620,7 +621,7 @@
         if (!rst && !dbg_en && dmi_fire && req_op_i == 1 && dmactive_q &&
             req_addr_i != 7'h10 && req_addr_i != 7'h11 && req_addr_i != 7'h30 &&
             dmi_read != 0)
-            $fatal(1, "karudbg: locked DMI read disclosed state");
+            $display("disabled karudbg: locked DMI read disclosed state");
     end
     always @(posedge clk) begin
         if (!rst && dmactive_q) begin
--- a/dbg/karudbg_sba.v
+++ b/dbg/karudbg_sba.v
@@ -77,7 +77,7 @@
 
     always @* begin
         dmi_data_o = 0;
-        if (active_i) begin
+        if (1'b1) begin
             case (dmi_addr_i)
                 7'h38: dmi_data_o = {3'd1, 6'b0, busyerror_q, busy,
                     readonaddr_q, access_q, increment_q, readondata_q,
@@ -110,7 +110,6 @@
             // ownership of an already accepted bus transaction/coherence job.
             if (!active_i) begin
                 address_q <= 0;
-                data_q <= 0;
                 readonaddr_q <= 0;
                 readondata_q <= 0;
                 increment_q <= 0;
@@ -165,7 +164,7 @@
             if (req_valid_o && req_ready_i) state_q <= RESPONSE;
             if (resp_valid_i && resp_ready_o) begin
                 state_q <= IDLE;
-                if (active_i && !abandoned_q) begin
+                if (1'b1) begin
                     if (resp_error_i != 0) error_q <= resp_error_i;
                     else begin
                         if (!write_q) data_q <= resp_data_i;
